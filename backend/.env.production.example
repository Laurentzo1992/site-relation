# Copy to "backend/.env.production". Never commit the real file.
# DATABASE_URL, CORS_ORIGINS, PUBLIC_BACKEND_URL and PUBLIC_FRONTEND_URL are
# set by docker-compose.prod.yml itself (derived from the root .env's DOMAIN
# and POSTGRES_* values) -- no need to repeat them here.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_SESSION_SECRET=

ACCESS_TOKEN_EXPIRE_MINUTES=1440
AD_PRICE=500
CONNECTION_REQUEST_PRICE=500
CURRENCY=XOF

# Providers offered at checkout: "mock", "ligdicash", "sebpay", or several
# comma-separated ("ligdicash,sebpay" -- the first is the default). Start with
# "mock" until the keys below are filled in and verified.
PAYMENT_PROVIDER=mock
LIGDICASH_BASE_URL=https://app.ligdicash.com
LIGDICASH_API_KEY=
LIGDICASH_AUTH_TOKEN=

# SebPay (Mobile Money). Use the pk_test_/sk_test_ pair first, pk_live_/sk_live_
# only once a test payment has gone through. Keep the secret key private.
SEBPAY_BASE_URL=https://newapi.sebpay.bj
SEBPAY_PUBLIC_KEY=
SEBPAY_SECRET_KEY=
