DATABASE_URL=postgresql+psycopg2://siterelation:siterelation@localhost:5432/siterelation
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_SESSION_SECRET=change-me-too-another-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AD_PRICE=500
CONNECTION_REQUEST_PRICE=500
CURRENCY=XOF
CORS_ORIGINS=http://localhost:5173

# "mock" for local dev (no external calls) or "ligdicash" for real payments
PAYMENT_PROVIDER=mock
LIGDICASH_BASE_URL=https://app.ligdicash.com
LIGDICASH_API_KEY=
LIGDICASH_AUTH_TOKEN=

# Must be publicly reachable URLs when PAYMENT_PROVIDER=ligdicash
# (LigdiCash calls PUBLIC_BACKEND_URL/payments/ligdicash/callback as a webhook)
PUBLIC_BACKEND_URL=http://localhost:8000
PUBLIC_FRONTEND_URL=http://localhost:5173
