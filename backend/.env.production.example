# Copy to "backend/.env.production". Never commit the real file.
# DATABASE_URL, CORS_ORIGINS, PUBLIC_BACKEND_URL and PUBLIC_FRONTEND_URL are
# set by docker-compose.prod.yml itself (derived from the root .env's DOMAIN
# and POSTGRES_* values) -- no need to repeat them here.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_SESSION_SECRET=

ACCESS_TOKEN_EXPIRE_MINUTES=1440
AD_PRICE=500
CONNECTION_REQUEST_PRICE=500
CURRENCY=XOF

# Start with "mock" until LigdiCash keys are filled in and verified, then
# switch to "ligdicash".
PAYMENT_PROVIDER=mock
LIGDICASH_BASE_URL=https://app.ligdicash.com
LIGDICASH_API_KEY=
LIGDICASH_AUTH_TOKEN=
