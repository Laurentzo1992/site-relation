{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
}

{$DOMAIN} {
	import security_headers
	reverse_proxy frontend:80
	encode gzip
}

api.{$DOMAIN} {
	import security_headers
	reverse_proxy backend:8000
	encode gzip
}
