# Copy to ".env" at the project root (docker-compose.prod.yml reads from
# it). Never commit the real ".env" file.

# Frontend is served on DOMAIN, the API/admin on api.DOMAIN
# (www.DOMAIN redirects to DOMAIN in the shared Caddy).
DOMAIN=njarabi.info

POSTGRES_USER=siterelation
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=siterelation

# Name of the existing Docker network your VPS's shared Caddy container is
# already on ("proxy" on this server) -- if yours differs, find it with:
#   docker inspect <your-caddy-container> --format '{{json .NetworkSettings.Networks}}'
# This project's backend/frontend containers join it so that Caddy can
# reverse_proxy to them by container name. See DEPLOYMENT.md.
CADDY_NETWORK=proxy
